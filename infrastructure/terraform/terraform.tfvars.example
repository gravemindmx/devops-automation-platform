# ===== AWS Configuration =====
aws_region = "us-east-1"

# ===== AWS Infrastructure (Existing Resources) =====
# Estos valores ya existen en tu AWS y se referencian (no se crean)
vpc_id              = "vpc-0bf11b72e3d6c092b"      # Tu existing VPC
jenkins_instance_id = "i-0020a9bd1ba26e28a"       # Tu Jenkins EC2 instance (PRIVATE)
private_subnet_id   = "subnet-0466d9078c5271b99"  # Jenkins subnet (private, existente)

# ===== Public Infrastructure (Created by Terraform) =====
# NOTA: Los siguientes valores se crean automáticamente en Terraform
# - Internet Gateway
# - 2 Public Subnets (10.30.0.0/24, 10.30.1.0/24)
# - Route Table público
# - Rutas (0.0.0.0/0 → IGW)
# NO necesitas proporcionarlos manualmente

# ===== GitHub Configuration (REQUIRED - REEMPLAZA) =====
github_org   = "your-organization"                   # Tu organización GitHub
github_repo  = "devops-automation-platform"          # Tu repositorio GitHub

# ===== Teams Configuration (REQUIRED - REEMPLAZA) =====
# IMPORTANTE:
# - NO pongas valores reales aqui para evitar exponer secretos en Git.
# - Terraform toma estas variables desde el entorno usando el prefijo TF_VAR_.
#
# Mapeo:
#   TF_VAR_teams_webhook_url    -> variable "teams_webhook_url"
#   TF_VAR_teams_failure_webhook_url -> variable "teams_failure_webhook_url"
#
# Ejemplo PowerShell (Windows):
#   $env:TF_VAR_teams_webhook_url = "https://outlook.webhook.office.com/webhookb2/..."
#   $env:TF_VAR_teams_failure_webhook_url = "https://defaultbd6d8350d1ca40d59319c95f890af3.53.environment.api.powerplatform.com/..."
#
# Ejemplo Bash (Linux/macOS):
#   export TF_VAR_teams_webhook_url="https://outlook.webhook.office.com/webhookb2/..."
#   export TF_VAR_teams_failure_webhook_url="https://defaultbd6d8350d1ca40d59319c95f890af3.53.environment.api.powerplatform.com/..."

# ===== QA Environment =====
qa_environment_url = "https://qa-api.example.com"

# ===== Secretos (NO versionar) =====
# Exportar en tu shell antes de terraform plan/apply:
#   TF_VAR_github_token
#   TF_VAR_teams_webhook_url
#   TF_VAR_teams_failure_webhook_url
