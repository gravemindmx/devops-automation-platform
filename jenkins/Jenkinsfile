#!/usr/bin/env groovy

/**
 * DEVOPS AUTOMATION PLATFORM - MAIN CI/CD PIPELINE
 *
 * This pipeline automates the complete DevOps workflow:
 * 1. Build & Test
 * 2. Security Scanning
 * 3. Deploy to QA
 * 4. Validation
 * 5. Notification (Success/Failure) -> Teams
 * 6. On Failure: Auto-create Jira ticket
 *
 * Triggers: Webhook from GitHub on develop branch merge
 */

pipeline {
    agent any

    parameters {
        booleanParam(
            name: 'LOCK_SINGLE_REPO',
            defaultValue: true,
            description: 'Lock pipeline to one repo for pilot validation before multirepo rollout'
        )
        string(
            name: 'LOCK_GITHUB_ORG',
            defaultValue: 'gravemindmx',
            description: 'GitHub organization for single-repo lock mode'
        )
        string(
            name: 'LOCK_GITHUB_REPO',
            defaultValue: 'devops-automation-platform',
            description: 'GitHub repository for single-repo lock mode'
        )
        booleanParam(
            name: 'CREATE_BRANCH',
            defaultValue: false,
            description: 'Create a new GitHub feature branch from develop'
        )
        string(
            name: 'BRANCH_TO_CREATE',
            defaultValue: '',
            description: 'Branch name to create (e.g. feature/PROJ-123-description)'
        )
        booleanParam(
            name: 'APPLY_TERRAFORM',
            defaultValue: false,
            description: 'Run terraform plan/apply before build stages'
        )
        string(
            name: 'TERRAFORM_AUTO_APPROVE',
            defaultValue: 'true',
            description: 'Use true to auto-approve terraform apply'
        )
        string(
            name: 'JIRA_USER_EMAIL',
            defaultValue: 'infraestructura@imony.mx',
            description: 'Optional Jira user email. If provided, Jira ticket creation uses Basic auth (email + token).'
        )
        booleanParam(
            name: 'RUN_APP_REPO_TESTS',
            defaultValue: false,
            description: 'Run tests from secondary application repository in this central pipeline'
        )
        string(
            name: 'APP_REPO_URL',
            defaultValue: 'https://github.com/iMony-Tech/devops-automation-platform-test.git',
            description: 'Secondary application repository URL to test (repo 2)'
        )
        string(
            name: 'APP_REPO_BRANCH',
            defaultValue: 'develop',
            description: 'Branch to checkout from secondary application repository'
        )
    }

    triggers {
        // Triggered automatically by GitHub webhook on push/merge to develop
        githubPush()
    }

    options {
        // Keep last 30 builds
        buildDiscarder(logRotator(numToKeepStr: '30'))
        // Timeout after 30 minutes
        timeout(time: 30, unit: 'MINUTES')
        // Don't run concurrent builds
        disableConcurrentBuilds()
    }

    environment {
        // GitHub
        GITHUB_TOKEN = credentials('github-token')
        GITHUB_ORG = 'gravemindmx'
        GITHUB_REPO = 'devops-automation-platform'
        NODE_ENV = 'qa'
        PYTHON_BIN = '/usr/bin/python3.11'

        // AWS
        AWS_DEFAULT_REGION = 'us-east-1'
        AWS_REGION = 'us-east-1'
        LAMBDA_FUNCTION = 'devops-platform-teams-notifier'
        QA_LAMBDA_FUNCTION = 'devops-platform-teams-notifier'
        JIRA_HANDLER_FUNCTION = 'devops-platform-jira-event-handler'
        QA_JIRA_HANDLER_FUNCTION = 'devops-platform-jira-event-handler'

        // Jira
        JIRA_URL = credentials('jira-url')
        JIRA_API_TOKEN = credentials('jira-api-token')
        JIRA_DEFAULT_USER_EMAIL = 'infraestructura@imony.mx'
        JIRA_PROJECT_KEY = 'NFRTST'
        INFRA_READY = 'true'

        // Teams
        TEAMS_WEBHOOK = credentials('teams-webhook')
        TEAMS_QA_WEBHOOK = credentials('teams-qa-webhook')

        // Build info
        COMMIT_HASH = "${GIT_COMMIT.take(8)}"
        BRANCH_NAME = "${GIT_BRANCH.replaceAll('^.*//', '')}"
    }

    stages {
        stage('🔍 Checkout') {
            steps {
                script {
                    echo "═══════════════════════════════════════"
                    echo "Stage: Checkout"
                    echo "Branch: ${BRANCH_NAME}"
                    echo "Commit: ${COMMIT_HASH}"
                    echo "═══════════════════════════════════════"
                }
                checkout scm
            }
        }

        stage('🧭 Resolve GitHub Repository Context') {
            steps {
                script {
                    def remoteUrl = sh(script: 'git config --get remote.origin.url || true', returnStdout: true).trim()
                    def detectedOrg = ''
                    def detectedRepo = ''
                    if (remoteUrl) {
                        def matcher = (remoteUrl =~ /github\.com[\/:]([^\/]+)\/([^\/.]+)(?:\.git)?$/)
                        if (matcher.find()) {
                            detectedOrg = matcher.group(1)
                            detectedRepo = matcher.group(2)
                        }
                    }
                    def lockOrg = params.LOCK_GITHUB_ORG?.trim() ?: env.GITHUB_ORG?.trim() ?: 'gravemindmx'
                    def lockRepo = params.LOCK_GITHUB_REPO?.trim() ?: env.GITHUB_REPO?.trim() ?: 'devops-automation-platform'

                    if (params.LOCK_SINGLE_REPO == true) {
                        if (!lockOrg || !lockRepo) {
                            error('LOCK_SINGLE_REPO=true requires LOCK_GITHUB_ORG and LOCK_GITHUB_REPO.')
                        }

                        if (detectedOrg && detectedRepo && (detectedOrg != lockOrg || detectedRepo != lockRepo)) {
                            error('SCM repository does not match LOCK_GITHUB_ORG/LOCK_GITHUB_REPO for pilot mode.')
                        }

                        env.RESOLVED_GITHUB_ORG = lockOrg
                        env.RESOLVED_GITHUB_REPO = lockRepo
                    } else if (detectedOrg && detectedRepo) {
                        env.RESOLVED_GITHUB_ORG = detectedOrg
                        env.RESOLVED_GITHUB_REPO = detectedRepo
                    } else if (env.GITHUB_ORG?.trim() && env.GITHUB_REPO?.trim()) {
                        // Backward compatibility for classic pipeline jobs with manual variables
                        env.RESOLVED_GITHUB_ORG = env.GITHUB_ORG
                        env.RESOLVED_GITHUB_REPO = env.GITHUB_REPO
                    } else {
                        error('Unable to resolve repository context. Set lock parameters or use GitHub SCM URL.')
                    }

                    // Defensive fallback: some Jenkins setups do not expose parameter defaults reliably.
                    if (!env.RESOLVED_GITHUB_ORG?.trim()) {
                        env.RESOLVED_GITHUB_ORG = env.GITHUB_ORG
                    }
                    if (!env.RESOLVED_GITHUB_REPO?.trim()) {
                        env.RESOLVED_GITHUB_REPO = env.GITHUB_REPO
                    }
                    if (!env.RESOLVED_GITHUB_ORG?.trim()) {
                        env.RESOLVED_GITHUB_ORG = 'gravemindmx'
                    }
                    if (!env.RESOLVED_GITHUB_REPO?.trim()) {
                        env.RESOLVED_GITHUB_REPO = 'devops-automation-platform'
                    }

                    echo "Single-repo lock mode: ${params.LOCK_SINGLE_REPO}"
                    echo "Resolved GitHub org: ${env.RESOLVED_GITHUB_ORG ?: 'N/A'}"
                    echo "Resolved GitHub repo: ${env.RESOLVED_GITHUB_REPO ?: 'N/A'}"
                }
            }
        }

        stage('🛡️ Enforce PR Merge Policy') {
            when {
                expression { params.CREATE_BRANCH != true }
            }
            steps {
                script {
                    withCredentials([string(credentialsId: 'github-token', variable: 'GH_TOKEN')]) {
                        sh '''
                            set -e

                            VERIFY_ORG="${RESOLVED_GITHUB_ORG}"
                            VERIFY_REPO="${RESOLVED_GITHUB_REPO}"
                            VERIFY_COMMIT="${GIT_COMMIT}"
                            TARGET_BRANCH="${BRANCH_NAME#origin/}"

                            # If this run validates repo 2, enforce policy against app repo head commit.
                            if [ "${RUN_APP_REPO_TESTS}" = "true" ]; then
                                rm -rf app-repo-policy-check
                                APP_REPO_AUTH_URL=$(echo "${APP_REPO_URL}" | sed "s#https://#https://${GH_TOKEN}@#")
                                git clone --depth 1 --branch "${APP_REPO_BRANCH}" --single-branch "${APP_REPO_AUTH_URL}" app-repo-policy-check

                                cd app-repo-policy-check
                                VERIFY_COMMIT=$(git rev-parse HEAD)
                                cd ..

                                TARGET_BRANCH="${APP_REPO_BRANCH#origin/}"
                                VERIFY_ORG=$(echo "${APP_REPO_URL}" | sed -E 's#https://github.com/([^/]+)/([^/.]+)(\\.git)?#\\1#')
                                VERIFY_REPO=$(echo "${APP_REPO_URL}" | sed -E 's#https://github.com/([^/]+)/([^/.]+)(\\.git)?#\\2#')
                            fi

                            echo "PR policy validation target: ${VERIFY_ORG}/${VERIFY_REPO}"
                            echo "Target branch: ${TARGET_BRANCH}"
                            echo "Commit: ${VERIFY_COMMIT}"

                            if [ "${TARGET_BRANCH}" != "develop" ]; then
                                echo "❌ Policy violation: QA promotion is only allowed from merged PRs into develop."
                                echo "Current target branch: ${TARGET_BRANCH}"
                                rm -rf app-repo-policy-check || true
                                exit 1
                            fi

                            if [ -z "${VERIFY_ORG}" ] || [ -z "${VERIFY_REPO}" ] || [ -z "${VERIFY_COMMIT}" ]; then
                                echo "ERROR: Unable to resolve repository/commit for PR policy validation."
                                rm -rf app-repo-policy-check || true
                                exit 1
                            fi

                            PULLS_RESPONSE=$(curl -s \
                                -H "Authorization: Bearer ${GH_TOKEN}" \
                                -H "Accept: application/vnd.github+json" \
                                "https://api.github.com/repos/${VERIFY_ORG}/${VERIFY_REPO}/commits/${VERIFY_COMMIT}/pulls")

                            HAS_VALID_MERGED_PR=$(echo "$PULLS_RESPONSE" | TARGET_BRANCH="${TARGET_BRANCH}" "${PYTHON_BIN}" -c "
import json, os, sys
target = os.getenv('TARGET_BRANCH', '').strip()
try:
    data = json.load(sys.stdin)
    if isinstance(data, dict) and data.get('message'):
        print('no')
        sys.exit(0)
    for pr in data if isinstance(data, list) else []:
        base_ref = ((pr.get('base') or {}).get('ref') or '').strip()
        merged_at = pr.get('merged_at')
        if base_ref == target and merged_at:
            print('yes')
            sys.exit(0)
    print('no')
except Exception:
    print('no')
")

                            if [ "${HAS_VALID_MERGED_PR}" != "yes" ]; then
                                echo "❌ Policy violation: Commit ${VERIFY_COMMIT} is not associated with a merged PR into ${TARGET_BRANCH}."
                                echo "Only merged PR changes to develop are allowed for QA deployment."
                                rm -rf app-repo-policy-check || true
                                exit 1
                            fi

                            echo "✓ PR merge policy validated for commit ${VERIFY_COMMIT} on ${TARGET_BRANCH}."
                            rm -rf app-repo-policy-check || true
                        '''
                    }
                }
            }
        }

        stage('🌿 Create GitHub Branch') {
            when {
                expression { params.CREATE_BRANCH == true && params.BRANCH_TO_CREATE?.trim() }
            }
            steps {
                script {
                    if (!env.RESOLVED_GITHUB_ORG?.trim() || !env.RESOLVED_GITHUB_REPO?.trim()) {
                        error('Unable to resolve GitHub organization/repository from checkout. Ensure SCM points to GitHub or set GITHUB_ORG/GITHUB_REPO.')
                    }

                    echo "═══════════════════════════════════════"
                    echo "Stage: Create GitHub Branch"
                    echo "Branch: ${params.BRANCH_TO_CREATE}"
                    echo "Repository: ${env.RESOLVED_GITHUB_ORG}/${env.RESOLVED_GITHUB_REPO}"
                    echo "═══════════════════════════════════════"

                    withCredentials([string(credentialsId: 'github-token', variable: 'GH_TOKEN')]) {
                        sh """
                            set -e
                            git config user.email "jenkins@${env.RESOLVED_GITHUB_ORG}.com"
                            git config user.name "Jenkins CI"
                            git remote set-url origin https://\${GH_TOKEN}@github.com/${env.RESOLVED_GITHUB_ORG}/${env.RESOLVED_GITHUB_REPO}.git
                            git fetch origin --prune

                            BASE_BRANCH=""
                            if git ls-remote --exit-code --heads origin develop >/dev/null 2>&1; then
                                BASE_BRANCH="develop"
                            elif git ls-remote --exit-code --heads origin main >/dev/null 2>&1; then
                                BASE_BRANCH="main"
                            elif git ls-remote --exit-code --heads origin master >/dev/null 2>&1; then
                                BASE_BRANCH="master"
                            else
                                BASE_BRANCH=\$(git ls-remote --symref origin HEAD 2>/dev/null | awk '/^ref:/ {print \$2}' | sed 's#refs/heads/##')
                            fi

                            if [ -z "\$BASE_BRANCH" ]; then
                                echo "ERROR: No base branch found on remote (develop/main/master/default HEAD)."
                                exit 1
                            fi

                            TARGET_BRANCH="${params.BRANCH_TO_CREATE}"
                            echo "Using base branch: \$BASE_BRANCH"
                            echo "Target branch: \$TARGET_BRANCH"

                            if git ls-remote --exit-code --heads origin "\$TARGET_BRANCH" >/dev/null 2>&1; then
                                echo "Branch \$TARGET_BRANCH already exists on remote ✓"
                                exit 0
                            fi

                            git checkout -B "\$BASE_BRANCH" "origin/\$BASE_BRANCH"
                            git checkout -b "\$TARGET_BRANCH"
                            git push -u origin "\$TARGET_BRANCH"
                            echo "Branch \$TARGET_BRANCH created and pushed ✓"
                        """
                    }
                }
            }
        }

        stage('🏗️ Terraform Plan/Apply') {
            when {
                expression { params.APPLY_TERRAFORM == true }
            }
            steps {
                script {
                    echo "═══════════════════════════════════════"
                    echo "Stage: Terraform Plan/Apply"
                    echo "═══════════════════════════════════════"

                    withCredentials([
                        string(credentialsId: 'github-token', variable: 'TF_VAR_github_token'),
                        string(credentialsId: 'jira-url', variable: 'TF_VAR_jira_url'),
                        string(credentialsId: 'jira-api-token', variable: 'TF_VAR_jira_api_token'),
                        string(credentialsId: 'teams-webhook', variable: 'TF_VAR_teams_webhook_url'),
                        string(credentialsId: 'teams-qa-webhook', variable: 'TF_VAR_teams_qa_webhook_url')
                    ]) {
                        sh '''
                            set +x

                            echo "Preparing Lambda ZIP artifacts for Terraform..."
                            rm -rf services/teams-notifier/package services/jira-event-handler/package
                            rm -f services/teams-notifier/teams-notifier.zip services/jira-event-handler/jira-handler.zip

                            "${PYTHON_BIN}" -m pip install -r services/teams-notifier/config/requirements.txt \
                                -t services/teams-notifier/package/ --quiet
                            "${PYTHON_BIN}" -m pip install -r services/jira-event-handler/config/requirements.txt \
                                -t services/jira-event-handler/package/ --quiet

                            cp -r services/teams-notifier/src/. services/teams-notifier/package/
                            (
                                cd services/teams-notifier/package && \
                                zip -r ../teams-notifier.zip . -x "*.pyc" "*/__pycache__/*" > /dev/null 2>&1
                            )

                            cp -r services/jira-event-handler/src/. services/jira-event-handler/package/
                            (
                                cd services/jira-event-handler/package && \
                                zip -r ../jira-handler.zip . -x "*.pyc" "*/__pycache__/*" > /dev/null 2>&1
                            )

                            cd infrastructure/terraform

                            if [ ! -f terraform.tfvars ]; then
                                if [ -f terraform.tfvars.example ]; then
                                    cp terraform.tfvars.example terraform.tfvars
                                    echo "terraform.tfvars not found; created from terraform.tfvars.example"
                                else
                                    echo "ERROR: terraform.tfvars not found and terraform.tfvars.example is missing"
                                    exit 1
                                fi
                            fi

                            # Keep SCM-resolved GitHub context consistent in Terraform runs.
                            export TF_VAR_github_org="${RESOLVED_GITHUB_ORG:-$GITHUB_ORG}"
                            export TF_VAR_github_repo="${RESOLVED_GITHUB_REPO:-$GITHUB_REPO}"

                            terraform init
                            terraform plan -input=false -var-file=terraform.tfvars -out=tfplan

                            if [ "${TERRAFORM_AUTO_APPROVE}" = "true" ]; then
                                terraform apply -input=false -auto-approve tfplan
                            else
                                terraform apply -input=false tfplan
                            fi

                            echo "Terraform apply completed ✓"
                        '''
                    }
                }
            }
        }

        stage('🐍 Verify Python 3.11') {
            steps {
                sh '''
                    set -e
                    [ -x "${PYTHON_BIN}" ] || {
                        echo "ERROR: ${PYTHON_BIN} is not installed on Jenkins agent"
                        echo "Current PATH: ${PATH}"
                        exit 1
                    }

                    "${PYTHON_BIN}" --version
                    "${PYTHON_BIN}" -m pip --version || "${PYTHON_BIN}" -m ensurepip --upgrade
                '''
            }
        }

        stage('📦 Build') {
            steps {
                script {
                    try {
                        echo "═══════════════════════════════════════"
                        echo "Stage: Build"
                        echo "═══════════════════════════════════════"

                        sh '''
                            rm -rf services/teams-notifier/package services/jira-event-handler/package

                            echo "Installing deps for teams-notifier..."
                            "${PYTHON_BIN}" -m pip install -r services/teams-notifier/config/requirements.txt \
                                -t services/teams-notifier/package/ --quiet

                            echo "Installing deps for jira-event-handler..."
                            "${PYTHON_BIN}" -m pip install -r services/jira-event-handler/config/requirements.txt \
                                -t services/jira-event-handler/package/ --quiet

                            echo "Creating deployment packages..."
                            cp -r services/teams-notifier/src/. services/teams-notifier/package/
                            (
                                cd services/teams-notifier/package && \
                                zip -r ../teams-notifier.zip . -x "*.pyc" "*/__pycache__/*" > /dev/null 2>&1
                            )

                            cp -r services/jira-event-handler/src/. services/jira-event-handler/package/
                            (
                                cd services/jira-event-handler/package && \
                                zip -r ../jira-handler.zip . -x "*.pyc" "*/__pycache__/*" > /dev/null 2>&1
                            )

                            echo "Build successful ✓"
                        '''
                    } catch (Exception e) {
                        error("Build failed: ${e.message}")
                    }
                }
            }
        }

        stage('🧪 Test') {
            steps {
                script {
                    try {
                        echo "═══════════════════════════════════════"
                        echo "Stage: Test"
                        echo "═══════════════════════════════════════"

                        sh '''
                            # Install runtime deps for tests in Jenkins interpreter (not only package/ folder).
                            "${PYTHON_BIN}" -m pip install --quiet \
                                -r services/teams-notifier/config/requirements.txt \
                                -r services/jira-event-handler/config/requirements.txt \
                                pytest pytest-cov

                            echo "Running tests for teams-notifier..."
                            "${PYTHON_BIN}" -m pytest services/teams-notifier/tests/ -v --tb=short

                            echo "Running tests for jira-event-handler..."
                            "${PYTHON_BIN}" -m pytest services/jira-event-handler/tests/ -v --tb=short

                            echo "Tests completed ✓"
                        '''
                    } catch (Exception e) {
                        error("Tests failed: ${e.message}")
                    }
                }
            }
        }

        stage('🧪 Test App Repository (Repo 2)') {
            when {
                expression { params.RUN_APP_REPO_TESTS == true }
            }
            steps {
                script {
                    echo "═══════════════════════════════════════"
                    echo "Stage: Test App Repository (Repo 2)"
                    echo "Repo: ${params.APP_REPO_URL}"
                    echo "Branch: ${params.APP_REPO_BRANCH}"
                    echo "═══════════════════════════════════════"

                    withCredentials([string(credentialsId: 'github-token', variable: 'GH_TOKEN')]) {
                        sh '''
                            set -e

                            rm -rf app-repo
                            rm -f .app_repo_commit
                            rm -f .app_repo_author
                            APP_REPO_AUTH_URL=$(echo "${APP_REPO_URL}" | sed "s#https://#https://${GH_TOKEN}@#")

                            git clone --branch "${APP_REPO_BRANCH}" --single-branch "${APP_REPO_AUTH_URL}" app-repo

                            cd app-repo
                            APP_REPO_COMMIT=$(git rev-parse --short=8 HEAD)
                            APP_REPO_AUTHOR=$(git log -1 --pretty=format:"%an" 2>/dev/null || echo "Unknown")
                            echo "$APP_REPO_COMMIT" > ../.app_repo_commit
                            echo "$APP_REPO_AUTHOR" > ../.app_repo_author
                            echo "App repository commit under test: $APP_REPO_COMMIT"
                            echo "App repository author under test: $APP_REPO_AUTHOR"

                            if [ -f "requirements.txt" ]; then
                                "${PYTHON_BIN}" -m pip install --quiet -r requirements.txt
                            fi

                            if [ -d "tests" ]; then
                                "${PYTHON_BIN}" -m pytest tests/ -v --tb=short
                            elif ls test_*.py >/dev/null 2>&1; then
                                "${PYTHON_BIN}" -m unittest -v
                            else
                                echo "No tests found in app repository (expected tests/ or test_*.py)"
                                exit 1
                            fi

                            echo "App repository tests completed ✓"
                        '''
                    }
                }
            }
        }

        stage('🔐 Security Scan') {
            steps {
                script {
                    try {
                        echo "═══════════════════════════════════════"
                        echo "Stage: Security Scan"
                        echo "═══════════════════════════════════════"

                        sh '''
                            echo "Running dependency scan..."
                            if command -v npm >/dev/null 2>&1; then
                                npm audit --audit-level=moderate || true
                            else
                                echo "npm not installed on agent, skipping npm audit"
                            fi

                            echo "Checking for vulnerabilities..."
                            # You can add SonarQube, Snyk, or other tools here

                            echo "Security scan completed ✓"
                        '''
                    } catch (Exception e) {
                        // Don't fail on security warnings, just log
                        echo "Security scan warning: ${e.message}"
                    }
                }
            }
        }

        stage('🔎 Verify QA Infrastructure') {
            steps {
                script {
                    def infraCheckStatus = sh(
                        script: '''
                            set +e
                            aws lambda get-function \
                                --function-name "${QA_LAMBDA_FUNCTION}" \
                                --region "${AWS_REGION}" \
                                >/dev/null 2>&1
                            LAMBDA_STATUS=$?

                            aws lambda get-function \
                                --function-name "${QA_JIRA_HANDLER_FUNCTION}" \
                                --region "${AWS_REGION}" \
                                >/dev/null 2>&1
                            JIRA_HANDLER_STATUS=$?

                            if [ "$LAMBDA_STATUS" -eq 0 ] && [ "$JIRA_HANDLER_STATUS" -eq 0 ]; then
                                exit 0
                            fi

                            exit 1
                        ''',
                        returnStatus: true
                    )

                    if (infraCheckStatus != 0) {
                        if (params.APPLY_TERRAFORM == true) {
                            error('QA Lambda infrastructure is still missing after Terraform stage. Verify terraform apply and AWS permissions.')
                        }

                        currentBuild.result = 'UNSTABLE'
                        env.INFRA_READY = 'false'
                        echo 'QA Lambda infrastructure not found. Skipping Deploy/Validation. Run once with APPLY_TERRAFORM=true to provision resources.'
                    } else {
                        env.INFRA_READY = 'true'
                        echo 'QA Lambda infrastructure exists ✓'
                    }
                }
            }
        }

        stage('🚀 Deploy to QA') {
            when {
                expression { env.INFRA_READY == 'true' }
            }
            steps {
                script {
                    try {
                        echo "═════════════════════════════════════════"
                        echo "Stage: Deploy to QA"
                        echo "═════════════════════════════════════════"

                        sh '''
                            # Deploy teams-notifier
                            echo "Deploying teams-notifier to QA..."
                            aws lambda update-function-code \
                                --function-name "${QA_LAMBDA_FUNCTION}" \
                                --zip-file fileb://services/teams-notifier/teams-notifier.zip \
                                --region "${AWS_REGION}"

                            aws lambda wait function-updated \
                                --function-name "${QA_LAMBDA_FUNCTION}" \
                                --region "${AWS_REGION}"

                            # Deploy jira-event-handler
                            echo "Deploying jira-event-handler to QA..."
                            aws lambda update-function-code \
                                --function-name "${QA_JIRA_HANDLER_FUNCTION}" \
                                --zip-file fileb://services/jira-event-handler/jira-handler.zip \
                                --region "${AWS_REGION}"

                            aws lambda wait function-updated \
                                --function-name "${QA_JIRA_HANDLER_FUNCTION}" \
                                --region "${AWS_REGION}"

                            # Sync webhook/Jira environment variables from Jenkins credentials.
                            echo "Updating teams-notifier environment variables..."
                            aws lambda update-function-configuration \
                                --function-name "${QA_LAMBDA_FUNCTION}" \
                                --environment "Variables={TEAMS_WEBHOOK=${TEAMS_WEBHOOK}}" \
                                --region "${AWS_REGION}"

                            aws lambda wait function-updated \
                                --function-name "${QA_LAMBDA_FUNCTION}" \
                                --region "${AWS_REGION}"

                            echo "Updating jira-event-handler environment variables..."
                            aws lambda update-function-configuration \
                                --function-name "${QA_JIRA_HANDLER_FUNCTION}" \
                                --environment "Variables={TEAMS_WEBHOOK=${TEAMS_QA_WEBHOOK},JIRA_URL=${JIRA_URL}}" \
                                --region "${AWS_REGION}"

                            echo "Waiting for Lambdas to be ready..."
                            aws lambda wait function-updated \
                                --function-name "${QA_LAMBDA_FUNCTION}" \
                                --region "${AWS_REGION}"

                            aws lambda wait function-updated \
                                --function-name "${QA_JIRA_HANDLER_FUNCTION}" \
                                --region "${AWS_REGION}"

                            echo "Deployment to QA completed ✓"
                        '''
                    } catch (Exception e) {
                        error("Deploy to QA failed: ${e.message}")
                    }
                }
            }
        }

        stage('✅ Validation') {
            when {
                expression { env.INFRA_READY == 'true' }
            }
            steps {
                script {
                    try {
                        echo "═════════════════════════════════════════"
                        echo "Stage: Validation & Health Check"
                        echo "═════════════════════════════════════════"

                        sh '''
                            echo "Running health checks..."

                            # Test Lambda function
                            TEST_PAYLOAD=$(cat <<EOF
{
    "event_type": "build_success",
    "dry_run": true,
    "build_number": "${BUILD_NUMBER}",
    "branch": "${BRANCH_NAME}",
    "commit": "${COMMIT_HASH}",
    "build_url": "${BUILD_URL}",
    "environment": "qa"
}
EOF
)

                            aws lambda invoke \
                                --function-name "${QA_LAMBDA_FUNCTION}" \
                                --region "${AWS_REGION}" \
                                --cli-binary-format raw-in-base64-out \
                                --payload "$TEST_PAYLOAD" \
                                /tmp/lambda-test-response.json > /tmp/lambda-test-metadata.json

                            if grep -q "FunctionError" /tmp/lambda-test-metadata.json; then
                                echo "Lambda invocation returned FunctionError ✗"
                                cat /tmp/lambda-test-metadata.json
                                cat /tmp/lambda-test-response.json
                                exit 1
                            fi

                            # Check response
                            if grep -q '"statusCode"[[:space:]]*:[[:space:]]*200' /tmp/lambda-test-response.json; then
                                echo "Lambda health check passed ✓"
                            else
                                echo "Lambda health check failed ✗"
                                cat /tmp/lambda-test-response.json
                                exit 1
                            fi

                            echo "Validation completed ✓"
                        '''
                    } catch (Exception e) {
                        error("Validation failed: ${e.message}")
                    }
                }
            }
        }

        stage('📢 Notification - Success') {
            when {
                expression { currentBuild.result == null || currentBuild.result == 'SUCCESS' }
            }
            steps {
                script {
                    echo "═════════════════════════════════════════"
                    echo "Stage: Notification - Success"
                    echo "═════════════════════════════════════════"

                    sh '''
                        set +e
                        SUCCESS_COMMIT="${COMMIT_HASH}"
                        if [ -f ".app_repo_commit" ]; then
                            APP_TEST_COMMIT=$(cat .app_repo_commit | tr -d '\n')
                            if [ -n "$APP_TEST_COMMIT" ]; then
                                SUCCESS_COMMIT="$APP_TEST_COMMIT"
                            fi
                        fi

                        COMMIT_AUTHOR=$(git log -1 --pretty=format:"%an" 2>/dev/null || echo "Unknown")
                        if [ -f ".app_repo_author" ]; then
                            APP_TEST_AUTHOR=$(cat .app_repo_author | tr -d '\n')
                            if [ -n "$APP_TEST_AUTHOR" ]; then
                                COMMIT_AUTHOR="$APP_TEST_AUTHOR"
                            fi
                        fi
                        COMMIT_AUTHOR_SAFE=$(echo "${COMMIT_AUTHOR}" | tr -d '"\\\\<>')

                        RESOLVED_TICKET_KEYS=""
                        RESOLVED_TICKET_URLS=""

                        # --- Resolve open Jira failure tickets ---
                        if [ -n "${JIRA_API_TOKEN}" ] && [ -n "${JIRA_DEFAULT_USER_EMAIL}" ]; then
                            JIRA_AUTH_TOKEN=$(printf "%s:%s" "${JIRA_DEFAULT_USER_EMAIL}" "${JIRA_API_TOKEN}" | base64 | tr -d '\\n')
                            JIRA_AUTH_HEADER="Authorization: Basic ${JIRA_AUTH_TOKEN}"

                            BRANCH_LABEL=$(echo "jenkins-branch-${BRANCH_NAME}" | tr '/' '-' | tr ' ' '-' | cut -c1-100)
                            SEARCH_RESP=$(curl -s -G "${JIRA_URL}/rest/api/3/search/jql" \
                                -H "$JIRA_AUTH_HEADER" \
                                --data-urlencode "jql=project = ${JIRA_PROJECT_KEY} AND labels = \\"failed-build\\" AND labels = \\"${BRANCH_LABEL}\\" AND statusCategory != Done ORDER BY created DESC" \
                                --data-urlencode "maxResults=1" \
                                --data-urlencode "fields=summary,status")

                            OPEN_KEYS=$(echo "$SEARCH_RESP" | /usr/bin/python3.11 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    keys = [i['key'] for i in data.get('issues', [])]
    print(' '.join(keys))
except:
    print('')
")

                            for TICKET_KEY in $OPEN_KEYS; do
                                echo "Resolving Jira ticket: ${TICKET_KEY}"

                                # Add resolution comment
                                curl -s -X POST "${JIRA_URL}/rest/api/3/issue/${TICKET_KEY}/comment" \
                                    -H "$JIRA_AUTH_HEADER" \
                                    -H "Content-Type: application/json" \
                                    -d "{\"body\":{\"type\":\"doc\",\"version\":1,\"content\":[{\"type\":\"paragraph\",\"content\":[{\"type\":\"text\",\"text\":\"Resuelto automaticamente por Jenkins build #${BUILD_NUMBER} | Commit: ${SUCCESS_COMMIT} | Autor: ${COMMIT_AUTHOR_SAFE} | URL: ${BUILD_URL}\"}]}]}}" \
                                    > /dev/null

                                # Find transition ID for statusCategory=done
                                TRANSITIONS=$(curl -s "${JIRA_URL}/rest/api/3/issue/${TICKET_KEY}/transitions" -H "$JIRA_AUTH_HEADER")
                                DONE_ID=$(echo "$TRANSITIONS" | /usr/bin/python3.11 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    for t in data.get('transitions', []):
        if t.get('to', {}).get('statusCategory', {}).get('key', '') == 'done':
            print(t['id'])
            sys.exit(0)
    print('')
except:
    print('')
")

                                if [ -n "$DONE_ID" ]; then
                                    curl -s -X POST "${JIRA_URL}/rest/api/3/issue/${TICKET_KEY}/transitions" \
                                        -H "$JIRA_AUTH_HEADER" \
                                        -H "Content-Type: application/json" \
                                        -d "{\"transition\":{\"id\":\"${DONE_ID}\"}}" > /dev/null
                                    echo "✓ Ticket ${TICKET_KEY} transitioned to Done"
                                else
                                    echo "⚠ No Done transition found for ${TICKET_KEY}"
                                fi

                                RESOLVED_TICKET_KEYS="${RESOLVED_TICKET_KEYS} ${TICKET_KEY}"
                                RESOLVED_TICKET_URLS="${RESOLVED_TICKET_URLS} ${JIRA_URL}/browse/${TICKET_KEY}"
                            done
                        fi

                        # --- Build Teams message ---
                        TICKETS_TRIMMED=$(echo "$RESOLVED_TICKET_KEYS" | xargs)
                        if [ -n "$TICKETS_TRIMMED" ]; then
                            SUCCESS_MSG="✅ Build exitoso - Desplegado a QA | Resuelto por: ${COMMIT_AUTHOR_SAFE} | Tickets cerrados: ${TICKETS_TRIMMED}"
                        else
                            SUCCESS_MSG="✅ Build exitoso - Desplegado a QA | Resuelto por: ${COMMIT_AUTHOR_SAFE}"
                        fi

                        PAYLOAD=$(cat <<EOF
{
    "event_type": "build_success",
    "build_number": "${BUILD_NUMBER}",
    "repository": "${APP_REPO_URL:-${GIT_URL}}",
    "branch": "${BRANCH_NAME}",
    "commit": "${SUCCESS_COMMIT}",
    "resolved_by": "${COMMIT_AUTHOR_SAFE}",
    "resolved_tickets": "${TICKETS_TRIMMED}",
    "status": "EXITOSO",
    "message": "${SUCCESS_MSG}",
    "environment": "QA",
    "build_url": "${BUILD_URL}",
    "timestamp": "$(date -u +'%Y-%m-%dT%H:%M:%SZ')"
}
EOF
)

                        aws lambda invoke \
                            --function-name "${LAMBDA_FUNCTION}" \
                            --region "${AWS_REGION}" \
                            --cli-binary-format raw-in-base64-out \
                            --payload "$PAYLOAD" \
                            /tmp/notification-response.json

                        if grep -q '"statusCode"[[:space:]]*:[[:space:]]*200' /tmp/notification-response.json; then
                            echo "Success notification sent to Teams ✓"
                        else
                            echo "⚠ Teams notification lambda executed but message delivery failed"
                            cat /tmp/notification-response.json
                        fi
                    '''
                }
            }
        }
    }

    post {
        failure {
            script {
                echo "═════════════════════════════════════════"
                echo "Pipeline FAILED - Error Handling"
                echo "═════════════════════════════════════════"

                sh '''
                    INCIDENT_COMMIT="${COMMIT_HASH}"
                    if [ -f ".app_repo_commit" ]; then
                        APP_TEST_COMMIT=$(cat .app_repo_commit | tr -d '\\n')
                        if [ -n "$APP_TEST_COMMIT" ]; then
                            INCIDENT_COMMIT="$APP_TEST_COMMIT"
                        fi
                    fi

                    ERROR_MESSAGE="Build #${BUILD_NUMBER} failed on ${BRANCH_NAME} (commit: ${INCIDENT_COMMIT}). See: ${BUILD_URL}"
                    ISSUE_KEY="N/A"
                    ISSUE_SUMMARY="N/A"
                    ISSUE_SUMMARY_PAYLOAD="N/A"
                    JIRA_BROWSE_URL=""
                    JIRA_ACTION="none"
                    TEAMS_MESSAGE="❌ Build fallido - Revisar ticket de Jira"

                    echo "Error: $ERROR_MESSAGE"

                    # Step 1: Create Jira ticket
                    EFFECTIVE_JIRA_EMAIL="${JIRA_DEFAULT_USER_EMAIL}"

                    if [ -n "${JIRA_USER_EMAIL}" ] && [ "${JIRA_USER_EMAIL}" != "${JIRA_DEFAULT_USER_EMAIL}" ]; then
                        echo "ℹ Ignoring JIRA_USER_EMAIL override from upstream (${JIRA_USER_EMAIL}) and using service account ${JIRA_DEFAULT_USER_EMAIL}."
                    fi

                    if [ -z "$EFFECTIVE_JIRA_EMAIL" ]; then
                        echo "⚠ JIRA_USER_EMAIL is empty. Jira Cloud API token requires Basic auth (email + token)."
                    else
                        JIRA_AUTH_TOKEN=$(printf "%s:%s" "$EFFECTIVE_JIRA_EMAIL" "${JIRA_API_TOKEN}" | base64 | tr -d '\\n')
                        JIRA_AUTH_HEADER="Authorization: Basic ${JIRA_AUTH_TOKEN}"

                        ERROR_SANITIZED=$(echo "$ERROR_MESSAGE" | tr -d '"' | cut -c1-500)
                        ISSUE_SUMMARY="[PIPELINE FAILED] ${BRANCH_NAME} - ${INCIDENT_COMMIT}"
                        ISSUE_SUMMARY_SANITIZED=$(echo "$ISSUE_SUMMARY" | tr -d '"' | cut -c1-200)
                        FAILURE_SIGNATURE="jenkins-failure-${INCIDENT_COMMIT}"
                        BRANCH_LABEL=$(echo "jenkins-branch-${BRANCH_NAME}" | tr '/' '-' | tr ' ' '-' | cut -c1-100)

                        # Auto-discover first valid issue type for this project
                        JIRA_ISSUE_TYPE=$(curl -s -X GET \
                            "${JIRA_URL}/rest/api/3/project/${JIRA_PROJECT_KEY}" \
                            -H "$JIRA_AUTH_HEADER" \
                            | /usr/bin/python3.11 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    types = [t['name'] for t in data.get('issueTypes', [])]
    preferred = ['Incident','Incidente','Service Request','Solicitud de servicio','Bug','Task','Story']
    for p in preferred:
        if p in types:
            print(p)
            sys.exit(0)
    print(types[0] if types else 'Bug')
except:
    print('Bug')
")
                        echo "Using Jira issue type: \$JIRA_ISSUE_TYPE"

                        # Deduplicate: reuse existing open issue with the same failure signature
                        SEARCH_RESPONSE=$(curl -s -G \
                            "${JIRA_URL}/rest/api/3/search/jql" \
                            -H "$JIRA_AUTH_HEADER" \
                            --data-urlencode "jql=project = ${JIRA_PROJECT_KEY} AND labels = ${FAILURE_SIGNATURE} AND statusCategory != Done ORDER BY created DESC" \
                            --data-urlencode "maxResults=1" \
                            --data-urlencode "fields=summary")

                        EXISTING_ISSUE_KEY=$(echo "$SEARCH_RESPONSE" | /usr/bin/python3.11 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    issues = data.get('issues', [])
    print(issues[0].get('key', '') if issues else '')
except:
    print('')
")

                        EXISTING_ISSUE_SUMMARY=$(echo "$SEARCH_RESPONSE" | /usr/bin/python3.11 -c "
import sys, json
try:
    data = json.load(sys.stdin)
    issues = data.get('issues', [])
    print(issues[0].get('fields', {}).get('summary', '') if issues else '')
except:
    print('')
")

                        if [ -n "$EXISTING_ISSUE_KEY" ]; then
                            ISSUE_KEY="$EXISTING_ISSUE_KEY"
                            ISSUE_SUMMARY="${EXISTING_ISSUE_SUMMARY:-$ISSUE_SUMMARY}"
                            JIRA_BROWSE_URL="${JIRA_URL}/browse/${ISSUE_KEY}"
                            JIRA_ACTION="reused"
                            echo "ℹ Reusing existing Jira ticket: $ISSUE_KEY"
                        else
                            ISSUE_RESPONSE=$(curl -s -X POST \
                                "${JIRA_URL}/rest/api/3/issue" \
                                -H "$JIRA_AUTH_HEADER" \
                                -H "Content-Type: application/json" \
                                -d @- <<EOF
{
    "fields": {
        "project": {"key": "${JIRA_PROJECT_KEY}"},
        "summary": "${ISSUE_SUMMARY_SANITIZED}",
        "description": {
            "type": "doc",
            "version": 1,
            "content": [
                {
                    "type": "paragraph",
                    "content": [
                        {"type": "text", "text": "${ERROR_SANITIZED}"}
                    ]
                }
            ]
        },
        "issuetype": {"name": "${JIRA_ISSUE_TYPE}"},
                        "labels": ["jenkins", "failed-build", "${FAILURE_SIGNATURE}", "${BRANCH_LABEL}"]
    }
}
EOF
)

                            ISSUE_KEY=$(echo "$ISSUE_RESPONSE" | grep -o '"key":"[^"]*' | cut -d'"' -f4)

                            if [ -n "$ISSUE_KEY" ] && [ "$ISSUE_KEY" != "null" ]; then
                                echo "✓ Jira ticket created: $ISSUE_KEY"
                                JIRA_BROWSE_URL="${JIRA_URL}/browse/${ISSUE_KEY}"
                                JIRA_ACTION="created"
                            else
                                echo "⚠ Failed to create Jira ticket"
                                echo "Response: $ISSUE_RESPONSE"
                                ISSUE_KEY="N/A"
                                JIRA_BROWSE_URL=""
                                ISSUE_SUMMARY="N/A"
                                JIRA_ACTION="none"
                            fi
                        fi

                        ISSUE_SUMMARY_PAYLOAD=$(echo "$ISSUE_SUMMARY" | tr -d '"' | cut -c1-180)

                        if [ "$JIRA_ACTION" = "created" ]; then
                            TEAMS_MESSAGE="❌ Build fallido - Ticket Jira creado: ${ISSUE_KEY} (${ISSUE_SUMMARY_PAYLOAD})"
                        elif [ "$JIRA_ACTION" = "reused" ]; then
                            TEAMS_MESSAGE="❌ Build fallido - Ticket Jira reutilizado: ${ISSUE_KEY} (${ISSUE_SUMMARY_PAYLOAD})"
                        fi
                    fi

                    # Step 2: Notify Teams via Lambda
                    FAILURE_PAYLOAD=$(cat <<PAYLOAD
{
    "event_type": "build_failure",
    "build_number": "${BUILD_NUMBER}",
    "repository": "${APP_REPO_URL:-${GIT_URL}}",
    "branch": "${BRANCH_NAME}",
    "commit": "${INCIDENT_COMMIT}",
    "status": "FALLIDO",
    "message": "$TEAMS_MESSAGE",
    "environment": "QA",
    "error": "$ERROR_MESSAGE",
    "jira_ticket": "$ISSUE_KEY",
    "jira_ticket_summary": "$ISSUE_SUMMARY_PAYLOAD",
    "jira_action": "$JIRA_ACTION",
    "jira_url": "$JIRA_BROWSE_URL",
    "build_url": "${BUILD_URL}",
    "timestamp": "$(date -u +\'%Y-%m-%dT%H:%M:%SZ\')"
}
PAYLOAD
)

                    aws lambda invoke \
                        --function-name "${LAMBDA_FUNCTION}" \
                        --region "${AWS_REGION}" \
                        --cli-binary-format raw-in-base64-out \
                        --payload "$FAILURE_PAYLOAD" \
                        /tmp/failure-notification.json || true

                    if grep -q '"statusCode"[[:space:]]*:[[:space:]]*200' /tmp/failure-notification.json; then
                        echo "Failure notification sent to Teams ✓"
                    else
                        echo "⚠ Teams failure notification was not delivered"
                        cat /tmp/failure-notification.json
                    fi
                '''
            }
        }

        always {
            script {
                def summaryOrg = env.RESOLVED_GITHUB_ORG?.trim() ?: params.LOCK_GITHUB_ORG?.trim() ?: env.GITHUB_ORG?.trim() ?: 'N/A'
                def summaryRepo = env.RESOLVED_GITHUB_REPO?.trim() ?: params.LOCK_GITHUB_REPO?.trim() ?: env.GITHUB_REPO?.trim() ?: 'N/A'

                echo "═════════════════════════════════════════"
                echo "Pipeline Summary"
                echo "═════════════════════════════════════════"
                echo "Build: #${BUILD_NUMBER}"
                echo "Branch: ${BRANCH_NAME}"
                echo "Commit: ${COMMIT_HASH}"
                echo "Repo: ${summaryOrg}/${summaryRepo}"
                echo "Status: ${currentBuild.result ?: 'IN PROGRESS'}"
                echo "═════════════════════════════════════════"
            }
        }
    }
}
